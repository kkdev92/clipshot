# Source files (bundled to dist/)
src/**
test/**

# Development files
.vscode/**
.claude/**
.git/**
.gitignore
*.ts
tsconfig.json
eslint.config.mjs
vitest.config.ts
esbuild.mjs

# Environment and secrets
.env
.env.*
.env.example

# node_modules - managed by bundleDependencies in package.json.
# Only sharp ships: it stays external to the esbuild bundle because of its
# native binaries. @kkdev92/vscode-ext-kit is a devDependency because esbuild
# inlines it into dist/extension.js, so shipping it too would be dead weight.
work/**

# Documentation (keep README)
CONTRIBUTING.md
SECURITY.md
docs/**

# Test coverage
coverage/**

# GitHub files (not needed by users)
.github/**

# Development scripts
scripts/**

# Source maps (not needed for production)
dist/**/*.map

# Sharp build files (pre-built binaries are used)
node_modules/sharp/src/**
node_modules/sharp/install/**

# Other
.mcp.json
*.vsix
*.map
.clipshot/**
.vsix-verify-temp/**

# Old tsc output (only keep bundled extension.js)
dist/**/*.d.ts
dist/**/*.d.ts.map
dist/clipboard/**
dist/config/**
dist/core/**
dist/detection/**
dist/image/**
dist/keyboard/**
dist/security/**
